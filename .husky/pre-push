#!/usr/bin/env sh
# Prefer local CI over GitHub Actions to save on GitHub credits.
# Decision logic lives in scripts/lib/pre-push.mjs (tested in
# test/scripts/pre-push.test.mjs); see docs/agents/ci.md#pre-push-hook.
#
# Escape hatch for an emergency push: `HUSKY=0 git push`. GitHub then runs
# full CI on that push since no stamp covers it.
[ "${HUSKY-}" = "0" ] && exit 0
if [ ! -d node_modules ]; then
  echo "pre-push: refusing silent skip — node_modules missing in this checkout."
  echo "  Run npm ci here, or use HUSKY=0 git push to bypass deliberately."
  echo "  See docs/agents/ci.md#pre-push-hook and docs/agents/policies/worktree.md"
  exit 1
fi
node scripts/ci/pre-push.mjs
