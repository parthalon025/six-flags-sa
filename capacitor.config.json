{
  "appId": "ai.kurat0r.parkbound",
  "appName": "Parkbound",
  "webDir": "native/www",
  "server": {
    "url": "https://parkbound.kurat0r.ai",
    "androidScheme": "https",
    "allowNavigation": [
      "parkbound.kurat0r.ai",
      "*.kurat0r.ai",
      "accounts.parkbound.kurat0r.ai",
      "clerk.parkbound.kurat0r.ai"
    ]
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK"
    },
    "Keyboard": {
      "resize": "body"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
