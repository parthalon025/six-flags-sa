{
  "appId": "com.parkbound.app",
  "appName": "Park Bound",
  "webDir": "native/www",
  "server": {
    "url": "https://parkbound.kurat0r.ai",
    "androidScheme": "https",
    "allowNavigation": ["parkbound.kurat0r.ai"]
  },
  "android": {
    "useLegacyBridge": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK"
    },
    "Keyboard": {
      "resize": "body"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
