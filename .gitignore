.DS_Store

# scratch harnesses agents drop at the root while verifying.
# They land here rather than /tmp because a script outside the repo cannot
# resolve `playwright` or the workspace packages, so a runnable throwaway has
# to sit where node's resolution reaches node_modules. These patterns are the
# names that actually show up; `*.tmp.mjs` alone missed `scratch-run-full.mjs`
# and `scratch-debug-follow.mjs.tmp.497.<hash>`, which is how four of them ended
# up as untracked noise in one session.
.drive-tmp.mjs
*.tmp.mjs
*.mjs.tmp.*
scratch-*.mjs
.scratch/*

# Wayfinder efforts — committed so macro / Cloud resume can track fog
!/.scratch/factories-to-app/
!/.scratch/factories-to-app/**
!/.scratch/g1-village-green/
!/.scratch/g1-village-green/**

# isolated worktrees agents check out while working in parallel
.claude/worktrees/
.worktrees/

# skills.sh agent junctions/copies — Matt skills are global (~/.agents/skills)
agent/
.agents/skills/
.claude/skills/*
!.claude/skills/gitnexus/
!.claude/skills/gitnexus/**

.turbo

