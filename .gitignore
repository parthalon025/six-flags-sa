# Display tiles are rebuilt from truth — GeoJSON export and PMTiles stay local
packages/venue-builder/data/venues/*/display/tiles/
packages/venue-builder/data/venues/*/display/base.pmtiles
# The pack-side bundle manifest hashes whatever optional tiers this machine
# built (pmtiles, worlds), so it differs per machine — the committed download
# contract is public/venues/<id>.bundle.json, written by reindex.
packages/venue-builder/data/venues/*/display/bundle.json
# Pack-side world PNGs are bake artifacts (regenerated by venues:bake +
# venues:display --bake); the sidecar .world.json stays tracked, and the
# published copies under apps/party-tracker/public are the human-gated ones.
packages/venue-builder/data/venues/*/display/*.world.png
packages/venue-builder/data/display/atlas/
packages/venue-builder/assets/reference/
artifacts/
packages/venue-builder/data/**/llm-briefs/
packages/venue-builder/data/llm-briefs/

# Terrain meshes (venues:display --mesh). Regenerated on demand, ~10 MB each,
# and nothing renders them yet — the heightfield they come from is the artifact
# worth keeping, not its OBJ.
packages/venue-builder/data/venues/*/display/*-terrain.obj
packages/venue-builder/data/venues/*/display/*-terrain.mtl
