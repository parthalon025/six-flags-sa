{
  "$schema_note": "CI / validate-ui modules. Path globs select which suites run for a diff; fullSuitePaths force everything when touched. Post-merge version-stamp-only commits select nothing. Functional modules map to gated sections in functional.mjs. `pulls` adds companion modules when this one is selected.",
  "fullSuitePaths": [
    ".github/workflows/test-app.yml",
    "package.json",
    "package-lock.json",
    "apps/party-tracker/package.json",
    "apps/party-tracker/next.config.*",
    "apps/party-tracker/app/page.js",
    "apps/party-tracker/app/layout.js",
    "test/app/functional.mjs",
    "test/app/grandma.mjs",
    "test/app/validate-ui.mjs",
    "test/app/browser.mjs",
    "test/app/modules.json",
    "test/app/lib/module-select.mjs",
    "test/app/select-modules.mjs",
    "test/app/visual.mjs",
    "test/app/theme.mjs",
    "test/app/ux.mjs"
  ],
  "modules": [
    {
      "id": "lint",
      "title": "ESLint (party-tracker)",
      "kind": "lint",
      "paths": [
        "apps/party-tracker/**/*.js",
        "apps/party-tracker/**/*.jsx",
        "apps/party-tracker/**/*.mjs",
        "apps/party-tracker/package.json",
        "eslint.config.mjs"
      ]
    },
    {
      "id": "selector",
      "title": "Module-select unit",
      "kind": "selector",
      "paths": [
        "test/app/module-select.test.mjs"
      ]
    },
    {
      "id": "contract",
      "title": "Critical-path coverage contract",
      "kind": "contract",
      "paths": [
        "test/app/critical-paths.json",
        "test/app/coverage-contract.mjs"
      ]
    },
    {
      "id": "builder",
      "title": "Builder unit + compare",
      "kind": "builder",
      "paths": [
        "packages/venue-builder/**",
        "scripts/build-venue.mjs",
        "scripts/attractions.mjs",
        "scripts/lib/**",
        "test/builder/**",
        "apps/party-tracker/public/venues/**",
        "apps/party-tracker/lib/venueIndex.js",
        "data/venues/**"
      ],
      "pulls": ["venues"]
    },
    {
      "id": "smoke",
      "title": "Functional — map chrome / sheet / theme",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/components/ParkMap.jsx",
        "apps/party-tracker/components/Sheet.jsx",
        "apps/party-tracker/components/GlanceRail.jsx",
        "apps/party-tracker/components/NavBar.jsx",
        "apps/party-tracker/app/globals.css",
        "apps/party-tracker/lib/theme.js",
        "apps/party-tracker/lib/sheet.js",
        "apps/party-tracker/lib/mapThemeTokens.js",
        "apps/party-tracker/lib/mapSymbols.js",
        "apps/party-tracker/lib/mapLabels.js",
        "apps/party-tracker/lib/mapViewport.js"
      ]
    },
    {
      "id": "heights",
      "title": "Functional — rider heights",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/components/HeightPanel.jsx",
        "apps/party-tracker/lib/ontology.js",
        "apps/party-tracker/app/api/rides/**"
      ]
    },
    {
      "id": "walk",
      "title": "Functional — walking / routing",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/components/NavBanner.jsx",
        "apps/party-tracker/components/RoutePreview.jsx",
        "apps/party-tracker/lib/routing.js",
        "apps/party-tracker/lib/routingProfiles.js",
        "apps/party-tracker/lib/entrance.js",
        "apps/party-tracker/lib/geo.js",
        "apps/party-tracker/lib/gps/**"
      ]
    },
    {
      "id": "party",
      "title": "Functional — party / join / host migration",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/components/PartyPanel.jsx",
        "apps/party-tracker/components/SideQuestsPanel.jsx",
        "apps/party-tracker/components/PlaceDetail.jsx",
        "apps/party-tracker/components/ParkMap.jsx",
        "apps/party-tracker/lib/party/**",
        "apps/party-tracker/lib/partyRuntime.js",
        "apps/party-tracker/lib/transport/**",
        "apps/party-tracker/lib/core/**",
        "apps/party-tracker/lib/overlay.js",
        "apps/party-tracker/lib/live.js",
        "apps/party-tracker/lib/reunification.js",
        "apps/party-tracker/lib/auth/**",
        "apps/party-tracker/app/join/**",
        "apps/party-tracker/app/api/party/**",
        "apps/party-tracker/app/api/mailbox/**",
        "apps/party-tracker/app/api/members/**",
        "apps/party-tracker/app/api/member/**",
        "apps/party-tracker/app/api/heartbeat/**",
        "apps/party-tracker/app/api/location/**",
        "apps/party-tracker/app/api/_lib/party.js",
        "apps/party-tracker/app/api/contributions/**"
      ],
      "pulls": ["grandma"]
    },
    {
      "id": "intake",
      "title": "Functional — welcome / nearest-park gate",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/components/GpsGate.jsx",
        "apps/party-tracker/components/IntroSplash.jsx",
        "apps/party-tracker/components/UpdateSplash.jsx",
        "apps/party-tracker/lib/brand.js",
        "apps/party-tracker/lib/releaseNotes.js",
        "apps/party-tracker/lib/appUpdate.js",
        "apps/party-tracker/lib/venue/store.js",
        "apps/party-tracker/lib/venue/useVenue.js",
        "apps/party-tracker/lib/venue/arrival.js"
      ],
      "pulls": ["grandma"]
    },
    {
      "id": "venues",
      "title": "Functional — per-venue smoke + camping + admin",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/public/venues/**",
        "apps/party-tracker/lib/venue/**",
        "apps/party-tracker/lib/venueIndex.js",
        "apps/party-tracker/lib/camping.js",
        "apps/party-tracker/lib/venueCompare.js",
        "apps/party-tracker/app/api/admin/**",
        "packages/venue-builder/data/venues/**"
      ]
    },
    {
      "id": "offline",
      "title": "Functional — PWA / offline map",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/public/sw.js",
        "apps/party-tracker/public/manifest.webmanifest",
        "apps/party-tracker/lib/install.js",
        "apps/party-tracker/lib/transport/offlineQueue.js"
      ]
    },
    {
      "id": "auth",
      "title": "Functional — auth / Clerk-off guards",
      "kind": "functional",
      "paths": [
        "apps/party-tracker/app/sign-in/**",
        "apps/party-tracker/app/sign-up/**",
        "apps/party-tracker/lib/clerkConfigured.js",
        "apps/party-tracker/proxy.js",
        "apps/party-tracker/components/AuthGate.jsx",
        "apps/party-tracker/components/AuthBridge.jsx",
        "apps/party-tracker/components/SignInCard.jsx",
        "vercel.json"
      ],
      "pulls": ["smoke"]
    },
    {
      "id": "grandma",
      "title": "Grandma persona suite",
      "kind": "grandma",
      "script": "grandma.mjs",
      "paths": [
        "test/app/grandma.mjs"
      ]
    }
  ],
  "uiDefaultWhenAppTouches": {
    "paths": ["apps/party-tracker/**", "packages/shared/**"],
    "modules": ["smoke", "heights", "walk", "party", "intake", "venues", "offline", "grandma"]
  }
}
