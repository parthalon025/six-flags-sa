{
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Installing Matt Pocock skills"
          },
          {
            "type": "command",
            "command": "node scripts/gitnexus-sync.mjs startup",
            "timeout": 300,
            "statusMessage": "Building GitNexus index"
          },
          {
            "type": "command",
            "command": "node scripts/worktree.mjs preserve",
            "timeout": 300,
            "statusMessage": "Preserving local-only branches to archive/*"
          },
          {
            "type": "command",
            "command": "node scripts/worktree.mjs prune",
            "timeout": 30,
            "statusMessage": "Pruning leftover agent branches"
          },
          {
            "type": "command",
            "command": "node scripts/worktree.mjs status",
            "timeout": 15,
            "statusMessage": "Listing agent worktrees"
          },
          {
            "type": "command",
            "command": "node scripts/orchestrator.mjs brief",
            "timeout": 15,
            "statusMessage": "Loading the agent roster"
          },
          {
            "type": "command",
            "command": "node scripts/executive-resume.mjs start",
            "timeout": 120,
            "statusMessage": "Loading executive resume (NOW + inventory)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(kill:*)"]
  }
}
