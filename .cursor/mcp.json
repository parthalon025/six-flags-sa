{
  "mcpServers": {
    "mapbox-mcp": {
      "type": "http",
      "url": "https://mcp.mapbox.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MAPBOX_ACCESS_TOKEN}"
      }
    },
    "sprite-ai": {
      "type": "http",
      "url": "https://www.sprite-ai.art/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SPRITE_AI_API_KEY}"
      }
    }
  }
}
