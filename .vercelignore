# Keep the Vercel upload lean. Runtime only needs the app workspace + shared
# package; builder/docs/agent trees are never imported by Next.

agent/
.agents/
.claude/
.gitnexus/
docs/
fastlane/
secrets/
tmp/
test/
coverage/
.github/

# Root venue builder inputs only — do not match apps/party-tracker/data/
/data/

# Builder package source is large and unused at runtime; keep package.json so
# npm workspaces still resolve.
packages/venue-builder/**
!packages/venue-builder/package.json

# Repo scripts are not part of the Next build (ignoreCommand + bump stay).
scripts/**
!scripts/vercel-ignore.sh
!scripts/bump-version.mjs
!scripts/lib/
!scripts/lib/vercel-ignore.mjs
!scripts/lib/vercel-budget.mjs
!scripts/lib/vercel-deploy-gate.mjs
!scripts/lib/version-stamp.mjs
!scripts/lib/version-stamp-paths.json
!scripts/lib/repo-path.mjs
!scripts/lib/app-paths.mjs
!scripts/lib/app-paths.json
!scripts/lib/gitnexus-only.mjs

*.md
!apps/party-tracker/**/*.md
skills-lock.json
AGENTS.md
CLAUDE.md
CONTEXT.md
INSTALL.md
README.md
