{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisplayPackVisualSpec",
  "description": "Tippecanoe / MapLibre display pack contract — visual factory CI gate (ticket 18)",
  "type": "object",
  "required": ["version", "venue", "skin", "basedOn", "tokens", "surfaces"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "venue": { "type": "string", "minLength": 1 },
    "skin": { "type": "string", "minLength": 1 },
    "basedOn": {
      "type": "object",
      "required": ["map"],
      "properties": {
        "map": { "type": "string" },
        "revisionId": { "type": "string" }
      }
    },
    "tokens": { "type": "object" },
    "surfaces": {
      "type": "object",
      "minProperties": 1
    },
    "landTones": {
      "description": "Zone name -> mode -> { fill, stroke, label }. The retired shape is a bare hex per mode; the renderer degrades that to no tone rather than throwing, so the gate rejects it here (ticket 31).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "enum": ["day", "night"] },
        "additionalProperties": {
          "type": "object",
          "required": ["fill", "stroke", "label"],
          "properties": {
            "fill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "label": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        }
      }
    }
  }
}
