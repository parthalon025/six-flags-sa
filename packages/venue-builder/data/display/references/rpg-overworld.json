  "agentReview": [
    {
      "key": "style_texture_language",
      "prompt": "Tile art reads as discrete sprites/tiles, not smooth vector fills — the reference is a tilemap, not a recolor"
    },
    {
      "key": "style_tree_read",
      "prompt": "Trees read as canopy clusters in woods, scattered singles on grass — the reference's dense scrub forests"
    },
    {
      "key": "style_reference_resemblance",
      "prompt": "Overall: side-by-side with ref-rpg-overworld, a stranger names the same genre"
