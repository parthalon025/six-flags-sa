    },
    "serviceLayer": "visible"
  },
  "ground": {
    "outsideVsInside": {
      "minDeltaE": 2
    },
    "waterVsVegetation": {
      "minDeltaE": 3
    }
  },
  "structures": {
    "buildingStyle": "outline",
    "trackStyle": "mono",
    "edgeInk": {
      "anchor": "#2F4C7A",
      "deltaE": 24
    },
    "trackVsRoad": {
      "sharedInk": "trackStyle 'mono' — a survey blueprint draws every line in one ink (edgeInk #2F4C7A) and carries hierarchy in weight and dash, not hue. Separation from the paper is style_road_hierarchy's centerlineVsPaper row (ΔE >= 25); separating track from midway by colour would break the design language rather than serve it."
    }
  },
  "hierarchy": {
    "annotationOnTop": true,
    "oneBadgePerPoi": true,
    "layerOrder": [
      "terrain",
      "roads",
      "tracks",
      "buildings",
      "trees",
      "badges"
    ]
  },
  "agentReview": [
    {
      "key": "style_texture_language",
      "prompt": "Reads as an ink drawing: linework carries the information, fills stay paper-quiet"
    },
    {
      "key": "style_structure_language",
      "prompt": "Buildings are unfilled outlines; tracks are monoline ink; no sprite decoration anywhere"
    },
    {
      "key": "style_reference_resemblance",
      "prompt": "Overall: a surveyor would file it, a player would not mistake it for the game tier"
    }
  ],
