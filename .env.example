# Optional. Without these the party store lives in server memory, which is fine for
# `npm run dev`, a VPS, or any single long-running Node process, but resets on restart
# and does NOT work across serverless instances (Vercel).
#
# Create a free Redis database at https://upstash.com and paste the REST creds here
# to make party sharing durable and Vercel-safe.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push. Generate a pair with:
#   node -e "console.log(require(String.raw`web-push`).generateVAPIDKeys())"
# Without these the app runs exactly as before, minus the notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Gates /api/metrics, which reports store counters — party volume,
# store errors, uptime. With no token set the route is served in development and
# 404s in production, so a public deployment does not narrate itself by default.
# Set this to scrape it: `Authorization: Bearer <token>`, or ?token=<token>.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Fastlane — mobile store deployment (iOS App Store Connect + Google Play)
# Copy this file to `.env` at the repository root and fill in values before
# running `bundle exec fastlane`. Never commit `.env` or secret key files.
# See fastlane/README.md for the full setup guide.
# ---------------------------------------------------------------------------

# App identifiers (must match Xcode bundle ID and Android applicationId)
IOS_BUNDLE_IDENTIFIER=com.parkbound.app
ANDROID_PACKAGE_NAME=com.parkbound.app

# Numeric App Store Connect app ID (App Information → Apple ID)
APP_STORE_APPLE_ID=

# Apple Developer / App Store Connect team IDs (Membership details)
IOS_TEAM_ID=
IOS_ITC_TEAM_ID=

# Optional legacy Apple ID — not used when API key auth is configured
APPLE_ID=

# App Store Connect API Key (.p8) — Users and Access → Integrations → Keys
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8

# Google Play service account JSON — Play Console → Setup → API access
GOOGLE_PLAY_JSON_KEY_PATH=./secrets/google-play-service-account.json

# Native project paths (Capacitor defaults after `npx cap add ios/android`)
IOS_WORKSPACE_PATH=ios/App/App.xcworkspace
IOS_SCHEME=App
IOS_BUILD_CONFIGURATION=Release
ANDROID_PROJECT_PATH=android

# Monorepo web app that feeds the native shell
WEB_APP_PATH=apps/party-tracker

# Google Play release tracks
ANDROID_BETA_TRACK=internal
ANDROID_PRODUCTION_TRACK=production
ANDROID_BETA_RELEASE_STATUS=completed
ANDROID_PRODUCTION_RELEASE_STATUS=completed

# Android release signing (upload keystore — required for Play uploads)
ANDROID_KEYSTORE_PATH=./secrets/parkbound-upload.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=parkbound
ANDROID_KEY_PASSWORD=

# Optional overrides
ANDROID_VERSION_CODE=
IOS_CHANGELOG=
IOS_SKIP_METADATA=false
IOS_SKIP_SCREENSHOTS=true
IOS_SUBMIT_FOR_REVIEW=true
IOS_AUTOMATIC_RELEASE=false
IOS_SKIP_WAIT_FOR_PROCESSING=true
ANDROID_SKIP_METADATA=false
ANDROID_SKIP_IMAGES=true
ANDROID_SKIP_SCREENSHOTS=true
