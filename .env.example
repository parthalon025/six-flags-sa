# Optional. Without these the party store lives in server memory, which is fine for
# `npm run dev`, a VPS, or any single long-running Node process, but resets on restart
# and does NOT work across serverless instances (Vercel).
#
# Preferred on Vercel: Marketplace → Upstash for Redis (sets KV_REST_API_*).
# Or create a free Redis database at https://upstash.com and paste REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace Upstash / KV (accepted as an alternative to UPSTASH_*):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Web Push. Generate a pair with:
#   node -e "console.log(require(String.raw`web-push`).generateVAPIDKeys())"
# Without these the app runs exactly as before, minus the notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Gates /api/metrics, which reports store counters — party volume,
# store errors, uptime. With no token set the route is served in development and
# 404s in production, so a public deployment does not narrate itself by default.
# Set this to scrape it: `Authorization: Bearer <token>`, or ?token=<token>.
METRICS_TOKEN=

# Optional. Gates GET /api/contributions/traces (operator export of guest walk
# uploads) and the venue-builder guest-traces adapter fetch. Falls back to
# METRICS_TOKEN when unset. POST uploads from phones do not need this token.
GUEST_TRACES_TOKEN=

# Optional. Base URL the venue builder uses when fetching guest traces
# (`npm run venues:sync-sources -- <id>` with guest-traces). Example:
#   GUEST_TRACES_API=https://your-deployment.example
GUEST_TRACES_API=

# Optional. Postgres for E0 profiles/contributions (docker-compose sets default).
# Without DATABASE_URL contributions use in-memory storage (dev/tests).
DATABASE_URL=

# Optional. Databricks back-office (see docs/guide/databricks.md).
# Free tier: OAuth via `databricks auth login` — no PAT needed locally.
# Run `npm run databricks:free-setup` once; dev job schedules deploy PAUSED.
DATABRICKS_HOST=
# DATABRICKS_TOKEN=   # CI/service principal only — not needed for local OAuth
PARKBOUND_API_BASE=
VENUE_LLM_PROVIDER=openai
# VENUE_LLM_PROVIDER=databricks   # costs Model Serving tokens — skip on free tier
# VENUE_LLM_MODEL=databricks-meta-llama-3-1-8b-instruct
#
# Free local Postgres (optional): docker compose up -d db
# DATABASE_URL=postgres://parkbound:parkbound@localhost:5432/parkbound
#
# Free Vercel add-ons (Marketplace): Neon Postgres + Upstash Redis — $0 tiers

# Clerk (Profile signup — ADR-0010). Create app at dashboard.clerk.com or run `clerk init`.
# Cloud Agents: add these as secrets on the Cursor environment (not in this file).
# Install runs `node scripts/cloud-agent-clerk-env.mjs` → apps/party-tracker/.env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# CLERK_WEBHOOK_SIGNING_SECRET=   # user.created / user.deleted sync (optional backup)

# ---------------------------------------------------------------------------
# Fastlane — mobile store deployment (iOS App Store Connect + Google Play)
# Copy this file to `.env` at the repository root and fill in values before
# running `bundle exec fastlane`. Never commit `.env` or secret key files.
# See fastlane/README.md for the full setup guide.
# ---------------------------------------------------------------------------

# App identifiers (must match Xcode bundle ID and Android applicationId)
IOS_BUNDLE_IDENTIFIER=ai.kurat0r.parkbound
ANDROID_PACKAGE_NAME=ai.kurat0r.parkbound

# Numeric App Store Connect app ID (App Information → Apple ID)
APP_STORE_APPLE_ID=

# Apple Developer / App Store Connect team IDs (Membership details)
IOS_TEAM_ID=
IOS_ITC_TEAM_ID=

# Optional legacy Apple ID — not used when API key auth is configured
APPLE_ID=

# App Store Connect API Key (.p8) — Users and Access → Integrations → Keys
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8

# Google Play service account JSON — Play Console → Setup → API access
GOOGLE_PLAY_JSON_KEY_PATH=./secrets/google-play-service-account.json

# Native project paths (Capacitor defaults after `npx cap add ios/android`)
IOS_WORKSPACE_PATH=ios/App/App.xcworkspace
IOS_SCHEME=App
IOS_BUILD_CONFIGURATION=Release
ANDROID_PROJECT_PATH=android

# Monorepo web app that feeds the native shell
WEB_APP_PATH=apps/party-tracker

# Google Play release tracks
ANDROID_BETA_TRACK=internal
ANDROID_PRODUCTION_TRACK=production
ANDROID_BETA_RELEASE_STATUS=completed
ANDROID_PRODUCTION_RELEASE_STATUS=completed

# Android release signing (upload keystore — required for Play uploads)
ANDROID_KEYSTORE_PATH=./secrets/parkbound-upload.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=parkbound
ANDROID_KEY_PASSWORD=

# Optional overrides
ANDROID_VERSION_CODE=
IOS_CHANGELOG=
IOS_SKIP_METADATA=false
IOS_SKIP_SCREENSHOTS=false
IOS_SUBMIT_FOR_REVIEW=false
IOS_AUTOMATIC_RELEASE=false
IOS_SKIP_WAIT_FOR_PROCESSING=true
ANDROID_SKIP_METADATA=false
ANDROID_SKIP_IMAGES=false
ANDROID_SKIP_SCREENSHOTS=false

# After Play enrollment: SHA-256 of the upload cert (`npm run store:prepare`).
# Also set this on Vercel so /.well-known/assetlinks.json is served.
# After Play App Signing is on, append the app-signing cert (comma-separated).
ANDROID_CERT_SHA256=

# After Apple enrollment: 10-character Team ID. Also set on Vercel so
# /.well-known/apple-app-site-association is served.
# IOS_TEAM_ID is listed above.
